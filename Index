<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Organoleptic Test</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .container {
            width: 90%;
            max-width: 400px;
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        h2 {
            text-align: center;
        }
        label {
            font-weight: bold;
            display: block;
            margin-top: 10px;
        }
        select, button {
            width: 100%;
            padding: 12px;
            margin-top: 5px;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 16px;
        }
        button {
            background: #28a745;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            border: none;
            margin-top: 15px;
        }
        button:hover {
            background: #218838;
        }
        #result {
            margin-top: 15px;
            font-weight: bold;
            text-align: center;
            font-size: 18px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Organoleptic Test</h2>
        <label for="branch">Branch:</label>
        <select id="branch">
            <option value="Kiambu">Kiambu</option>
            <option value="Ngong Road">Ngong Road</option>
        </select>
        
        <label for="size">Sample Size:</label>
        <select id="size">
            <option value="Size 3">Size 3</option>
            <option value="Size 4">Size 4</option>
            <option value="Size 5">Size 5</option>
            <option value="Size 6">Size 6</option>
        </select>
        
        <label for="gills">Gills:</label>
        <select id="gills">
            <option value="Red">Red</option>
            <option value="Dull">Dull</option>
        </select>
        
        <label for="texture">Texture:</label>
        <select id="texture">
            <option value="Firm">Firm</option>
            <option value="Loose">Loose</option>
        </select>
        
        <label for="smell">Smell:</label>
        <select id="smell">
            <option value="Characteristic">Characteristic</option>
            <option value="Pungent">Pungent</option>
        </select>
        
        <label for="eyes">Eyes:</label>
        <select id="eyes">
            <option value="Yellow/Black">Yellow/Black</option>
            <option value="Sunken">Sunken</option>
        </select>
        
        <label for="belly">Belly:</label>
        <select id="belly">
            <option value="Bright">Bright</option>
            <option value="Dull">Dull</option>
        </select>
        
        <button onclick="submitForm()">Submit</button>
        <p id="result"></p>
    </div>
    
    <script>
        function submitForm() {
            let gills = document.getElementById('gills').value;
            let texture = document.getElementById('texture').value;
            let smell = document.getElementById('smell').value;
            let eyes = document.getElementById('eyes').value;
            let belly = document.getElementById('belly').value;
            
            let status = (gills === 'Red' && texture === 'Firm' && smell === 'Characteristic' && eyes === 'Yellow/Black' && belly === 'Bright') ? 'Fish is OKAY' : 'Fish is NOT OKAY';
            document.getElementById('result').innerText = status;
            
            let data = {
                branch: document.getElementById('branch').value,
                size: document.getElementById('size').value,
                gills: gills,
                texture: texture,
                smell: smell,
                eyes: eyes,
                belly: belly,
                status: status
            };
            
            google.script.run.saveResponse(data);
        }
    </script>
</body>
</html>
